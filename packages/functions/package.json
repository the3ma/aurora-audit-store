{
  "name": "@audit/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node build.mjs",
    "migrate": "tsx --import ./loaders/register-text.mjs src/cli/migrate.ts",
    "api": "tsx --import ./loaders/register-text.mjs src/api/server.ts",
    "seed-legacy": "tsx --import ./loaders/register-text.mjs src/cli/seed-legacy.ts",
    "simulate-export": "tsx --import ./loaders/register-text.mjs src/cli/simulate-dynamodb-export.ts",
    "backfill": "tsx --import ./loaders/register-text.mjs src/cli/backfill.ts",
    "digest": "tsx --import ./loaders/register-text.mjs src/cli/digest.ts",
    "mv-refresh": "tsx --import ./loaders/register-text.mjs src/cli/mv-refresh.ts"
  },
  "dependencies": {
    "@audit/core": "^0.0.0",
    "@aws-sdk/client-cloudwatch": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-rds": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@hono/aws-lambda": "^1.0.1",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
