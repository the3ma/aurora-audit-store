{
  "name": "aurora-audit-store",
  "version": "0.0.0",
  "private": true,
  "description": "Append-only multi-tenant audit log on Aurora PostgreSQL, migrated from a single DynamoDB table.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @audit/functions",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:pg:local": "node scripts/test-pg-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm run -s migrate -w @audit/functions --",
    "api": "npm run -s api -w @audit/functions --",
    "seed-legacy": "npm run -s seed-legacy -w @audit/functions --",
    "simulate-export": "npm run -s simulate-export -w @audit/functions --",
    "backfill": "npm run -s backfill -w @audit/functions --",
    "digest": "npm run -s digest -w @audit/functions --",
    "mv-refresh": "npm run -s mv-refresh -w @audit/functions --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
